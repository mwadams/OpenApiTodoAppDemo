{
  "openapi": "3.2.0",
  "info": {
    "title": "ToDo App - Broker Frontend API",
    "version": "1.0.0",
    "description": "Public API consumed by the webapp frontend. Provides authentication, user profile gateway, and todo CRUD proxy endpoints."
  },
  "servers": [
    {
      "url": "http://localhost:5200",
      "description": "Broker"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "operationId": "register",
        "summary": "Proxy registration to the identity service",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRegister"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration succeeded and auth cookie was issued",
            "headers": {
              "Set-Cookie": {
                "description": "Authentication cookie for the registered user",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Proxy login to the identity service",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded and auth cookie was issued",
            "headers": {
              "Set-Cookie": {
                "description": "Authentication cookie for the logged-in user",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Clear the authentication cookie",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Logout succeeded and auth cookie was cleared",
            "headers": {
              "Set-Cookie": {
                "description": "Expired authentication cookie that clears the current session",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getAuthenticatedUser",
        "summary": "Get the current authenticated identity",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "name": "todo-session",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user claims",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUser"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
