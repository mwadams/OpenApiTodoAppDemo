  "components": {
    "schemas": {
      "TodoTitle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "TodoDescription": {
        "type": "string",
        "maxLength": 2000
      },
      "TodoStatus": {
        "type": "string",
        "enum": [
          "pending",
          "in-progress",
          "done",
          "cancelled"
        ]
      },
      "TodoPriority": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ]
      },
      "TodoTags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "TodoItem": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "$ref": "#/components/schemas/TodoTitle"
          },
          "description": {
            "$ref": "#/components/schemas/TodoDescription"
          },
          "status": {
            "$ref": "#/components/schemas/TodoStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/TodoPriority"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "tags": {
            "$ref": "#/components/schemas/TodoTags"
          },
          "assignee": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TodoList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TodoItem"
        }
      },
      "NewTodo": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "$ref": "#/components/schemas/TodoTitle"
          },
          "description": {
            "$ref": "#/components/schemas/TodoDescription"
          },
          "status": {
            "$ref": "#/components/schemas/TodoStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/TodoPriority"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "tags": {
            "$ref": "#/components/schemas/TodoTags"
          },
          "assignee": {
            "type": "string"
          }
        }
      },
      "TodoUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "$ref": "#/components/schemas/TodoTitle"
          },
          "description": {
            "$ref": "#/components/schemas/TodoDescription"
          },
          "status": {
            "$ref": "#/components/schemas/TodoStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/TodoPriority"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "tags": {
            "$ref": "#/components/schemas/TodoTags"
          },
          "assignee": {
            "type": "string"
          }
        }
      },
      "ProvisioningNotification": {
        "description": "Callback notification from the request broker when storage provisioning completes or fails. Discriminated by entityType and status constants to enable type-safe Match dispatch.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/UserStorageProvisioned"
          },
          {
            "$ref": "#/components/schemas/OrganizationStorageProvisioned"
          },
          {
            "$ref": "#/components/schemas/OrganizationMemberStorageProvisioned"
          },
          {
            "$ref": "#/components/schemas/StorageProvisioningFailed"
          }
        ]
      },
      "UserStorageProvisioned": {
        "title": "User Storage Provisioned",
        "description": "Notification that a user's personal todo-list blob storage has been provisioned and is ready for initialization.",
        "type": "object",
        "required": [
          "entityId",
          "entityType",
          "status",
          "sasToken",
          "payload"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the newly provisioned user"
          },
          "entityType": {
            "const": "user"
          },
          "status": {
            "const": "provisioned"
          },
          "sasToken": {
            "type": "string",
            "description": "SAS token granting write access to the user's newly provisioned blob storage"
          },
          "payload": {
            "$ref": "#/components/schemas/NewUser",
            "description": "The original user creation request, echoed back so the stateless API can populate storage"
          }
        }
      },
      "OrganizationStorageProvisioned": {
        "title": "Organization Storage Provisioned",
        "description": "Notification that an organization's blob storage has been provisioned and is ready for initialization.",
        "type": "object",
        "required": [
          "entityId",
          "entityType",
          "status",
          "sasToken",
          "payload"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the newly provisioned organization"
          },
          "entityType": {
            "const": "organization"
          },
          "status": {
            "const": "provisioned"
          },
          "sasToken": {
            "type": "string",
            "description": "SAS token granting write access to the organization's newly provisioned blob storage"
          },
          "payload": {
            "$ref": "#/components/schemas/NewOrganization",
            "description": "The original organization creation request, echoed back so the stateless API can populate storage"
          }
        }
      },
      "OrganizationMemberStorageProvisioned": {
        "title": "Organization Member Storage Provisioned",
        "description": "Notification that an organization member's blob storage has been provisioned and is ready for initialization.",
        "type": "object",
        "required": [
          "entityId",
          "orgId",
          "entityType",
          "status",
          "sasToken",
          "payload"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the user who is the member"
          },
          "orgId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the organization"
          },
          "entityType": {
            "const": "organization-member"
          },
          "status": {
            "const": "provisioned"
          },
          "sasToken": {
            "type": "string",
