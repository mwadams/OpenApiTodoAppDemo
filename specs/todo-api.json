    "/callbacks/storage-provisioned": {
      "post": {
        "operationId": "onStorageProvisioned",
        "summary": "Callback endpoint for storage provisioning notifications",
        "tags": [
          "callbacks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisioningNotification"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged"
          },
          "409": {
            "description": "Concurrency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
