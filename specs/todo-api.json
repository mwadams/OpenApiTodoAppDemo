{
  "openapi": "3.2.0",
  "info": {
    "title": "ToDo App API",
    "version": "1.0.0",
    "description": "Back-end API for todo CRUD operations and provisioning callbacks. Expects SAS tokens in headers for storage access."
  },
  "servers": [
    {
      "url": "http://localhost:5100"
    }
  ],
  "paths": {
    "/users/{userId}/todos": {
      "get": {
        "operationId": "listUserTodos",
        "summary": "List all todos for a user",
        "tags": [
          "todos"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Storage-Sas-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "SAS token for accessing the user's blob storage"
          }
        ],
        "responses": {
          "200": {
            "description": "List of todos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoList"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "sasToken": []
          }
        ]
      },
      "post": {
        "operationId": "createUserTodo",
        "summary": "Create a new todo on the user's list",
        "tags": [
          "todos"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Storage-Sas-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "SAS token for accessing the user's blob storage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTodo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Todo created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoItem"
                }
              }
            }
          },
          "409": {
            "description": "Concurrency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "sasToken": []
          }
        ]
      }
    },
